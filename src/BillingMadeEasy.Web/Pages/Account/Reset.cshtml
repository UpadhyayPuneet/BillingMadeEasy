@page
@model BillingMadeEasy.Web.Pages.Account.ResetModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}
@if (Model.Problem is not null)
{
    <h1>That link didn't work</h1>
    <p class="muted">@Model.Problem</p>
    <a class="btn primary block" href="/Account/Forgot@(Model.Email is null ? "" : "?email=" + Uri.EscapeDataString(Model.Email))">Send a new link</a>
}
else
{
    <h1>Choose a new password</h1>
    <p class="muted">For @Model.Email. You'll be signed out everywhere else.</p>
    <form method="post" class="form" novalidate>
        <input type="hidden" name="u" value="@Model.PublicId" />
        <input type="hidden" name="t" value="@Model.Token" />
        <input type="email" value="@Model.Email" autocomplete="username" hidden readonly />
        <label class="field">
            <span>New password</span>
            <input asp-for="Password" autocomplete="new-password" autofocus />
            <span class="field-help">At least @Model.MinLength characters, not one you've used recently.</span>
            <span asp-validation-for="Password" class="field-error"></span>
        </label>
        <label class="field">
            <span>Type it again</span>
            <input asp-for="Confirm" autocomplete="new-password" />
            <span asp-validation-for="Confirm" class="field-error"></span>
        </label>
        <button type="submit" class="btn primary block">Save password <kbd>Enter</kbd></button>
    </form>
}
