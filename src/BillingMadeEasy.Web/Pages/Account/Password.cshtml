@page
@model BillingMadeEasy.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
    Layout = "_AuthLayout";
}
@if (Model.Done)
{
    <h1>Password changed</h1>
    <p class="muted">You're still signed in here. Every other device has been signed out.</p>
    <a class="btn primary block" href="/">Continue</a>
}
else
{
    <h1>@(Model.Required ? "Choose your own password" : "Change password")</h1>
    <p class="muted">@(Model.Required ? "Your account was set up with a temporary password. Replace it to continue." : "Other devices will be signed out.")</p>

    <form method="post" class="form" novalidate>
        <div asp-validation-summary="ModelOnly" class="notice danger"></div>
        @if (!Model.Required)
        {
            <label class="field">
                <span>Current password</span>
                <input asp-for="Current" autocomplete="current-password" autofocus />
                <span asp-validation-for="Current" class="field-error"></span>
            </label>
        }
        <label class="field">
            <span>New password</span>
            <input asp-for="Password" autocomplete="new-password" autofocus="@Model.Required" />
            <span class="field-help">At least @Model.MinLength characters, not one you've used recently.</span>
            <span asp-validation-for="Password" class="field-error"></span>
        </label>
        <label class="field">
            <span>Type it again</span>
            <input asp-for="Confirm" autocomplete="new-password" />
            <span asp-validation-for="Confirm" class="field-error"></span>
        </label>
        <button type="submit" class="btn primary block">Change password <kbd>Enter</kbd></button>
    </form>
    @if (!Model.Required)
    {
        <p class="small"><a href="/">Cancel</a></p>
    }
    else
    {
        <form method="post" asp-page="/Account/SignOut"><button type="submit" class="btn block">Sign out</button></form>
    }
}
