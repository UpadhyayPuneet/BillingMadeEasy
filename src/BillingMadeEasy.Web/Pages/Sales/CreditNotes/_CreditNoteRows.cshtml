@model BillingMadeEasy.Web.Pages.Sales.CreditNotes.IndexModel
@using BillingMadeEasy.Core.Billing
@using BillingMadeEasy.Web.Features.Sales
@using BillingMadeEasy.Web.Infrastructure.Formatting
@{ var r = Model.Result; }
@if (r.Total == 0)
{
    <section class="empty">
        <span class="ms empty-icon" aria-hidden="true">@(Model.Q is null ? "assignment_return" : "search_off")</span>
        <h2>@(Model.Q is not null ? $"No credit note matches “{Model.Q}”" : Model.CurrentView == "all" ? "No credit notes yet" : "Nothing here")</h2>
        @if (Model.CurrentView == "all" && Model.Q is null)
        {
            <p class="muted">An issued invoice is never edited. When goods come back or you give a discount after the sale, open the invoice and choose “Credit note”.</p>
        }
    </section>
}
else
{
    <p class="result-count muted" aria-live="polite">@r.Total.ToString("N0") @(r.Total == 1 ? "credit note" : "credit notes")</p>
    <div class="table-wrap">
        <table class="grid-table" data-row-nav>
            <thead><tr><th scope="col">Credit note</th><th scope="col">Customer</th><th scope="col">Date</th><th scope="col">Against</th><th scope="col">Reason</th><th scope="col" class="num">GST</th><th scope="col" class="num">Amount</th></tr></thead>
            <tbody>
                @foreach (var n in r.Rows)
                {
                    bool cancelled = n.Status == CreditNoteStatus.Cancelled;
                    <tr data-href="/Sales/CreditNotes/View/@n.CreditNoteId" tabindex="0" class="@(cancelled ? "inactive" : null)">
                        <td><a href="/Sales/CreditNotes/View/@n.CreditNoteId" class="mono"><strong>@n.NoteNumber</strong></a> @if (cancelled) { <span class="badge warn">Cancelled</span> }</td>
                        <td><strong>@n.BuyerName</strong>@if (n.BuyerGstin is not null) { <span class="sub mono">@n.BuyerGstin</span> }</td>
                        <td>@n.NoteDate.ToString("d MMM yyyy")</td>
                        <td class="mono">@n.InvoiceNumber</td>
                        <td>@CreditNoteReasons.Name(n.ReasonCode)</td>
                        <td class="num">@Money.Amount(n.Tax)</td>
                        <td class="num">@Money.Inr(n.GrandTotal)@if (n.CreditLeft > 0) { <span class="sub">@Money.Inr(n.CreditLeft) credit left</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (r.Pages > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (r.Page > 1) { <a href="@Model.Link(page: r.Page - 1)" rel="prev" data-key="[">‹ Previous <kbd>[</kbd></a> }
            <span class="muted">Page @r.Page of @r.Pages</span>
            @if (r.Page < r.Pages) { <a href="@Model.Link(page: r.Page + 1)" rel="next" data-key="]">Next › <kbd>]</kbd></a> }
        </nav>
    }
}
